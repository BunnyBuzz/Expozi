{
  "name": "expozi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "dist": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "got-scraping": "^4.2.2",
    "lucide-react": "^0.469.0",
    "node-llama-cpp": "^3.22.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.14.2",
    "wink-bm25-text-search": "^3.1.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "com.expozi.app",
    "productName": "Expozi",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
